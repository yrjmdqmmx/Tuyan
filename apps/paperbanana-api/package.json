{
  "name": "@paperbanana/paperbanana-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "check:model-drift": "tsx scripts/check-openrouter-model-drift.ts",
    "check": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/server.cjs --alias:@lafjs/cloud=./src/laf-cloud.ts --alias:jpeg-js=./node_modules/jpeg-js --external:@resvg/resvg-wasm --external:ali-oss --external:express --external:mongodb --external:sharp && esbuild src/image-runtime-entry.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/image-runtime.mjs --alias:@lafjs/cloud=./src/laf-cloud.ts --alias:jpeg-js=./node_modules/jpeg-js --external:@resvg/resvg-wasm --external:sharp",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@paperbanana/benchmark-core": "workspace:*",
    "@resvg/resvg-wasm": "2.6.2",
    "ali-oss": "^6.23.0",
    "express": "^5.1.0",
    "fflate": "0.8.3",
    "jpeg-js": "0.4.4",
    "mongodb": "^6.18.0",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.16.11",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
