# Required: auth-gateway -> internal Node service transport secret.
PAPERBANANA_GATEWAY_TOKEN=replace-with-a-long-random-secret

# Required until durable job leases support multiple API replicas.
PAPERBANANA_SINGLE_REPLICA=true

# Required: never persist generated images as Mongo data URLs if OSS fails.
PAPERBANANA_STRICT_OBJECT_STORAGE=true

# Required Mongo business database. The database name defaults to paperbanana_business.
MONGODB_URI=mongodb://username:password@mongodb.internal:27017/?authSource=admin
MONGODB_BUSINESS_DB=paperbanana_business

# Required private Alibaba Cloud OSS bucket configuration.
PAPERBANANA_BUCKET=paperbanana-private
OSS_REGION=oss-cn-hongkong
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
# Required, distinct endpoints: server I/O stays on the Alibaba Cloud internal
# endpoint while browser/iOS presigned URLs always use the public endpoint.
OSS_INTERNAL_ENDPOINT=https://oss-cn-hongkong-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com

# Optional listener settings.
HOST=0.0.0.0
PORT=3000

# Optional bounded in-process admission/readiness settings (defaults shown).
PAPERBANANA_MAX_ACTIVE_JOBS=1
PAPERBANANA_MAX_PENDING_JOBS=2
PAPERBANANA_MAX_JOBS_PER_OWNER=1
PAPERBANANA_MAX_JOBS_PER_IP=1
PAPERBANANA_READINESS_PROBE_TIMEOUT_MS=2000
PAPERBANANA_PROVIDER_ACCOUNT_PROBE_TIMEOUT_MS=12000
PAPERBANANA_MAX_PROVIDER_IMAGE_BYTES=20971520

# Optional legacy handler settings. ADMIN_TOKEN is injected server-side only for
# admin actions after internal transport authentication; it is never accepted
# from the caller body. Manual BYOK keys remain in request memory; the optional
# TokenDance connection below stores only authenticated users' encrypted keys.
ADMIN_TOKEN=
REFERENCE_UPLOAD_TOKEN_SECRET=
PLOT_WORKER_URL=
PLOT_WORKER_TOKEN=
PAPERBANANA_MAX_REFERENCE_IMAGES=3
PAPERBANANA_MAX_REFERENCE_BYTES=5242880
PAPERBANANA_REFERENCE_UPLOAD_TTL_SECONDS=900
PAPERBANANA_SVG_REFERENCE_RASTER_WIDTH=1024
OPENROUTER_MODEL_CACHE_TTL_MS=3600000
PAPERBANANA_MAX_CANDIDATES=3
PAPERBANANA_MAX_CRITIC_ROUNDS=2
PAPERBANANA_CANDIDATE_CONCURRENCY=1
BAILIAN_VISION_MODEL=qwen-vl-max

# Optional TokenDance user connections, encrypted with a stable, independent
# base64-encoded 32-byte random secret. Empty disables connections; never reuse
# a transport/session secret. Keep out of Git, browser bundles, and logs.
TOKENDANCE_ENCRYPTION_KEY=
# Omit in production to use the registered first-party root. app_url and
# X-App-URL ALWAYS remain https://www.paperbanana.asia/ including the final slash.
TOKENDANCE_CALLBACK_URL=https://www.paperbanana.asia/
# Optional product-owner credential: admin pricing only, never user inference.
TOKENDANCE_MANAGEMENT_KEY=
TOKENDANCE_APPLICATION_ID=01M22GYKP6XTME912AJ18BK2S9
