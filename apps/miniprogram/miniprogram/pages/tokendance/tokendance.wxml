<view class="td-page">
  <view class="td-card">
    <view class="td-title">图研账号</view>
    <view class="td-email">{{email || '请先返回工作台登录'}}</view>
    <button wx:if="{{email}}" bindtap="manageAccount">账号与隐私</button>
    <button bindtap="returnToTask">返回原页面</button>
  </view>
  <view class="td-error" wx:if="{{error}}">{{error}}</view>
  <view class="td-note" wx:if="{{notice}}">{{notice}}</view>
  <view class="td-card">
    <view class="td-title">观猹 TokenDance</view>
    <view>{{connected ? '已连接' : '未连接'}}</view>
    <view class="td-note">使用自己的账户额度生成和精修图片。授权 Key 加密保存在服务端。</view>
    <button bindtap="authorize" loading="{{busy}}" disabled="{{busy}}">{{connected ? '重新授权' : '连接观猹 TokenDance'}}</button>
    <view wx:if="{{state}}">
      <view class="td-note">链接已复制。在系统浏览器完成授权，将一次性 code 粘贴到下方。</view>
      <input placeholder="一次性授权 code" password value="{{code}}" bindinput="codeInput"/>
      <button bindtap="exchange" disabled="{{busy || !code}}">完成授权</button>
      <button bindtap="cancel">取消授权</button>
    </view>
    <button wx:if="{{connected}}" bindtap="disconnect">解除连接</button>
  </view>
  <view class="td-card" wx:if="{{connected}}">
    <view class="td-title">钱包与充值</view>
    <view>可用余额 ¥{{balance || '—'}}</view>
    <button bindtap="queryBalance">查询余额</button>
    <view class="td-note">钱包余额与 Key 额度不同。Key 额度需在观猹 TokenDance 查看；充值不会调整 Key 限额，也不会恢复已禁用或到期的 Key。</view>
    <view>充值金额（人民币元）</view>
    <input type="number" value="{{amount}}" bindinput="amountInput"/>
    <button bindtap="createPayment" disabled="{{busy}}">创建 ¥{{amount}} 充值单</button>
    <view wx:if="{{payment}}">
      <view>¥{{payment.amount}} · {{payment.status === 'paid' ? '已确认到账' : payment.status === 'pending' ? '等待支付' : payment.status === 'refunded' ? '已退款' : '支付未完成'}}</view>
      <button wx:if="{{payment.status === 'pending' && payment.alipay_url}}" bindtap="copyAlipay">复制支付宝支付链接</button>
      <view class="td-note" wx:if="{{payment.status === 'pending'}}">微信小程序不能直接唤起支付宝。请用系统浏览器打开支付宝链接，或在图研网页充值；返回后查询支付状态。</view>
      <button bindtap="paymentStatus">查询支付状态</button>
    </view>
    <button bindtap="openWebWallet">复制图研网页账户入口</button>
  </view>
  <view class="td-card">
    <view class="td-title">充值记录</view>
    <view class="td-note">最近 10 笔通过图研创建的充值单；到账以支付状态查询为准。</view>
    <button bindtap="recentPayments">刷新记录</button>
    <view class="td-history-row" wx:for="{{payments}}" wx:key="attemptId">
      <view><text>¥{{item.amount}}</text><text>{{item.statusText}}</text><view wx:if="{{item.createdText}}" class="td-note">{{item.createdText}}</view></view>
      <button wx:if="{{item.session}}" data-attempt-id="{{item.attemptId}}" bindtap="queryHistoryPayment">查询状态</button>
    </view>
    <view wx:if="{{historyLoaded && !payments.length}}" class="td-note">暂无充值记录</view>
  </view>
</view>
<account-settings show="{{showAccountSettings}}" bind:close="closeAccountSettings" />
