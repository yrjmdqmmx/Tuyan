.td-page{padding:28rpx;color:#25473d}.td-card{background:white;border:1rpx solid #d8e2dc;border-radius:24rpx;padding:30rpx;margin-bottom:24rpx;display:flex;flex-direction:column;gap:22rpx}.td-title{font-size:40rpx;font-weight:600}.td-note{font-size:25rpx;color:#596e64;line-height:1.7;overflow-wrap:anywhere}.td-error{color:#a63327;padding:24rpx;overflow-wrap:anywhere}input{border:1rpx solid #bccfc3;border-radius:12rpx;padding:18rpx}button{font-size:28rpx;width:100%;margin:0;background:#eaf4ee;color:#254f3f}

.td-email{overflow-wrap:anywhere;font-size:28rpx}.td-history-row{display:flex;justify-content:space-between;gap:20rpx;border-top:1rpx solid #d8e2dc;padding-top:20rpx;font-size:28rpx}
.td-history-row>view{flex:1;min-width:0}.td-history-row text{margin-right:16rpx}.td-history-row>button{width:auto;flex-shrink:0;font-size:24rpx;align-self:center}.td-page>.td-note{margin-bottom:24rpx}
