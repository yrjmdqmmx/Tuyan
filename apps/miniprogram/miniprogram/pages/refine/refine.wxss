.refine-page{background:radial-gradient(circle at 85% 0,#d9eadd,transparent 360rpx),#f3f2ee}.refine-hero{margin:24rpx;padding:34rpx;border-radius:28rpx;background:linear-gradient(145deg,#173d35,#2e6958);color:#fff;box-shadow:0 20rpx 42rpx rgba(28,67,55,.22)}.refine-kicker{color:#dfc47d;font-size:18rpx;font-weight:850;letter-spacing:3rpx}.refine-title{margin-top:10rpx;font-size:38rpx;font-weight:880}.refine-sub{margin-top:10rpx;color:rgba(255,255,255,.76);font-size:22rpx;line-height:1.6}.registry-banner{display:flex;justify-content:space-between;margin:0 24rpx;padding:14rpx 18rpx;border-radius:14rpx;font-size:20rpx}.registry-banner.ready{background:#e9f4ed;color:#315f51}.registry-banner.error{background:#fff0e8;color:#914b32}.registry-retry{margin:0;height:46rpx;line-height:46rpx;font-size:18rpx}.refine-preview{width:100%;margin-top:18rpx;border-radius:18rpx;background:#eceee9}.refine-route{display:flex;align-items:center;justify-content:space-between}.refine-mode{font-size:29rpx;font-weight:850;color:#2e6654}.refine-instruction{height:260rpx;min-height:260rpx;max-height:400rpx}.refine-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:22rpx}.refine-grid .picker-value{font-size:22rpx}.result-grid{margin-top:20rpx}.footer-space{height:160rpx}
