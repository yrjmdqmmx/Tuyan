<scroll-view class="page refine-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="refine-heading"><view class="refine-title">精修图片</view><view class="refine-sub">保留原图，按你的指令调整细节。</view></view>
  <view class="error-box registry-error" wx:if="{{!registryReady}}">{{registryError || '正在读取模型目录'}}<button class="compact-button" bindtap="retryRegistry">重试</button></view>
  <view class="refine-workspace">
    <view class="refine-step">
      <view class="step-heading"><view class="step-label"><text class="step-number">1</text>选择原图</view><button wx:if="{{!isLoggedIn && !isAuthChecking}}" class="compact-button" bindtap="openAuthPanel">登录</button></view>
      <button wx:if="{{!source && !uploadBusy}}" class="source-empty" disabled="{{!uploadEnabled || isSubmitting || optimizationBusy}}" bindtap="chooseSourceFile"><text class="upload-symbol">＋</text><text class="upload-title">上传精修原图</text><text class="upload-caption">{{sourceSummary || 'PNG / JPG / WebP'}}</text></button>
      <view class="source-selected" wx:if="{{source}}">
        <image wx:if="{{source.url}}" class="refine-preview" src="{{source.url}}" mode="aspectFit" bindtap="previewSource" />
        <view class="source-name">{{source.label}}<text wx:if="{{source.width}}"> · {{source.width}} × {{source.height}}</text></view>
        <view class="source-actions"><button class="compact-button" wx:if="{{uploadEnabled}}" disabled="{{isSubmitting || optimizationBusy || uploadBusy}}" bindtap="chooseSourceFile">替换原图</button><button class="compact-button quiet" disabled="{{isSubmitting}}" bindtap="removeSource">移除</button></view>
      </view>
      <view class="source-history" wx:if="{{sourceOptions.length}}"><picker range="{{sourceOptions}}" range-key="label" value="{{sourceIndex}}" bindchange="onSourceChange" disabled="{{isSubmitting || uploadBusy}}"><view class="history-link">从任务结果选择 <text>›</text></view></picker></view>
      <view class="upload-status" wx:if="{{uploadStage}}"><text>{{uploadStage}}</text><button wx:if="{{uploadBusy}}" class="compact-button" bindtap="removeSource">取消上传</button></view>
      <view class="error-box" wx:if="{{uploadError}}">{{uploadError}}<button class="compact-button" wx:if="{{canRetryUpload}}" bindtap="retryUpload">重新上传</button></view>
      <view class="field-tip" wx:if="{{!uploadEnabled && registryReady}}">原图上传暂不可用，请从任务结果选择。</view>
      <view class="error-box" wx:if="{{sourceSelectionIssue}}">{{sourceSelectionIssue}}</view>
      <button class="details-toggle" bindtap="toggleDetails" aria-expanded="{{detailsOpen}}"><text>模型限制与图片处理</text><text>{{detailsOpen ? '−' : '+'}}</text></button>
      <view wx:if="{{detailsOpen}}" class="details-content">{{referenceProcessingHint}}</view>
    </view>
    <view class="refine-step">
      <view class="step-heading"><view class="step-label"><text class="step-number">2</text>精修指令</view><text class="instruction-count">{{instruction.length}} / 2000</text></view>
      <textarea class="textarea refine-instruction" maxlength="2000" value="{{instruction}}" placeholder="例如：放大标签，让箭头更清晰；保留原有文字、配色和布局。" bindinput="onInstructionInput" cursor-spacing="24" show-confirm-bar="{{false}}" />
      <view class="instruction-tools"><text class="instruction-tip">写清修改内容与需要保留的部分。</text><input-optimizer target="editInstruction" inputs="{{optimizationInputs}}" main-route="{{settings.modelRoutes.main || emptyObject}}" provider-regions="{{settings.providerRegions || emptyObject}}" disabled="{{isSubmitting || uploadBusy || optimizationBusy}}" bind:apply="onOptimizationApply" bind:busy="onOptimizationBusy" bind:settings="openOptimizationSettings" /></view>
    </view>
    <view class="refine-step">
      <view class="step-heading"><view class="step-label"><text class="step-number">3</text>调整参数</view><button class="compact-button quiet" bindtap="openSettings">精修设置 ›</button></view>
      <view class="refine-route"><text class="route-name">{{providerLabel}} · {{modelLabel}}</text><text class="refine-mode">{{refineModeLabel}}</text></view>
      <view class="connection-line" wx:if="{{settings.modelRoutes.image.accessProvider === 'tokendance'}}"><text class="connection-dot {{connected ? 'connected' : ''}}"></text><text>{{connected ? '观猹账户已连接' : '请在账户页连接观猹 TokenDance'}}</text></view>
      <view class="resolution-row"><text class="field-label">清晰度</text><picker range="{{resolutionOptions}}" range-key="label" value="{{resolutionIndex}}" bindchange="onResolutionChange" disabled="{{isSubmitting}}"><view class="resolution-picker">{{resolutionOptions[resolutionIndex].label || '不可用'}} <text>⌄</text></view></picker></view>
      <view class="field-label">目标比例</view><ratio-picker options="{{ratioOptions}}" value="{{settings.aspectRatio || 'auto'}}" disabled="{{isSubmitting}}" bind:change="selectRatio" />
    </view>
    <view class="refine-submit"><button class="refine-submit-button" loading="{{isSubmitting}}" disabled="{{!canSubmit}}" bindtap="submitRefine">{{isSubmitting ? '正在提交精修' : '提交精修'}}</button><view class="submit-tip" wx:if="{{!canSubmit && submitHint}}">{{submitHint}}</view><view class="error-box" wx:if="{{error && (!job || job.status !== 'failed')}}">{{error}}</view></view>
  </view>
  <view class="refine-results">
    <view class="step-heading"><view class="step-label">精修结果</view><view class="result-actions" wx:if="{{currentJobId}}"><button class="compact-button quiet" bindtap="refreshCurrentJob">刷新</button><button class="compact-button quiet" bindtap="openJobDetail">详情 ›</button></view></view>
    <view class="result-empty" wx:if="{{!currentJobId}}"><text class="result-empty-symbol">▧</text><view class="result-empty-title">让原图更接近你的想法</view><view>选择原图，描述修改，再提交精修。</view></view>
    <view class="result-status {{job.status === 'failed' ? 'failed' : ''}}" wx:elif="{{!job.result_images.length}}"><view class="result-status-title">{{job.status === 'failed' ? '精修未完成' : (job.status_text || '任务已受理，正在处理')}}</view><view wx:if="{{job.status === 'failed'}}">{{error || job.error}}</view><view wx:else>可到任务记录查看进度，返回后继续查看结果。</view></view>
    <view class="result-grid" wx:if="{{job.result_images.length}}"><view wx:for="{{job.result_images}}" wx:key="url" class="refine-result"><image class="result-image" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" bindtap="previewImage" /><view class="source-name">{{item.filename}}</view><view class="source-actions"><button class="compact-button" data-url="{{item.url}}" bindtap="saveImage">保存图片</button><button class="compact-button" data-url="{{item.url}}" bindtap="shareImage">发送文件</button></view></view></view>
    <stage-timeline wx:if="{{job}}" stages="{{job.stages}}" references="{{job.retrieved_references}}" />
    <view wx:if="{{job.recovery}}" class="error-box">{{job.recovery.message}}<navigator url="/pages/job-detail/job-detail?jobId={{job.id}}">查看原任务并恢复</navigator></view>
  </view>
  <view class="footer-space"></view>
</scroll-view>
<auth-panel show="{{showAuthPanel}}" bind:close="closeAuthPanel" bind:authed="onAuthed" />
<generation-settings-sheet purpose="{{settingsPurpose}}" show="{{showSettings}}" registry-version="{{registryVersion}}" settings="{{settings}}" api-keys="{{apiKeysForSheet}}" execution-roles="{{settingsExecutionRoles}}" bind:close="closeSettings" bind:save="saveSettings" />
