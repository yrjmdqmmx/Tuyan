<scroll-view class="page refine-page" scroll-y type="list">
  <view class="refine-hero"><view class="refine-kicker">INDEPENDENT REFINE</view><view class="refine-title">精修你的研究图示</view><view class="refine-sub">上传原图，或从自己的生成结果继续修改。</view></view>
  <view class="registry-banner ready" wx:if="{{registryReady}}">模型目录 {{registryVersion}}</view><view class="registry-banner error" wx:else>{{registryError || '正在读取模型目录'}}<button class="registry-retry" bindtap="retryRegistry">重试</button></view>
  <view class="section">
    <view class="section-head"><view><view class="section-title">选择源图</view><view class="section-note">支持 PNG、JPG、WebP 原图，也可选择账号中的历史结果。</view></view><button wx:if="{{!isLoggedIn && !isAuthChecking}}" class="ghost-button" size="mini" bindtap="openAuthPanel">登录</button></view>
    <picker wx:if="{{sourceOptions.length}}" range="{{sourceOptions}}" range-key="label" value="{{sourceIndex}}" bindchange="onSourceChange"><view class="picker-value">{{sourceOptions[sourceIndex].label}}</view></picker>
    <view class="empty-state" wx:else>暂无历史结果，可上传一张原图开始。</view>
    <view class="source-actions"><button class="ghost-button" size="mini" wx:if="{{uploadEnabled}}" disabled="{{isSubmitting || optimizationBusy}}" bindtap="chooseSourceFile">{{source ? '更换原图' : '上传原图'}}</button><button class="ghost-button" size="mini" wx:if="{{source || uploadBusy}}" disabled="{{isSubmitting}}" bindtap="removeSource">{{uploadBusy ? '取消上传' : '移除源图'}}</button></view>
    <view class="field-tip" wx:if="{{!uploadEnabled && registryReady}}">当前服务尚未提供原图上传，请使用历史任务结果。</view>
    <view class="upload-status" wx:if="{{uploadStage}}">{{uploadStage}}</view>
    <view class="error-box" wx:if="{{uploadError}}">{{uploadError}}<button wx:if="{{canRetryUpload}}" size="mini" bindtap="retryUpload">重新上传</button></view>
    <view class="source-name" wx:if="{{source}}">{{source.label}}<text wx:if="{{source.width}}"> · {{source.width}} × {{source.height}}</text></view>
    <image wx:if="{{source.url}}" class="refine-preview" src="{{source.url}}" mode="widthFix" />
  </view>
  <view class="section">
    <view class="refine-route"><view><view class="field-label">当前精修能力</view><view class="refine-mode">{{refineModeLabel}}</view></view><button class="ghost-button" size="mini" bindtap="openSettings">模型与密钥</button></view>
    <view class="field"><view class="field-label">精修指令</view><textarea class="textarea refine-instruction" maxlength="2000" value="{{instruction}}" placeholder="例如：放大标签、减少装饰、保持结构不变并让流程箭头更清晰。" bindinput="onInstructionInput" /><input-optimizer target="editInstruction" inputs="{{optimizationInputs}}" main-route="{{settings.modelRoutes.main || emptyObject}}" provider-regions="{{settings.providerRegions || emptyObject}}" disabled="{{isSubmitting || uploadBusy || optimizationBusy}}" bind:apply="onOptimizationApply" bind:busy="onOptimizationBusy" bind:settings="openOptimizationSettings" /></view>
    <view class="refine-grid"><view><view class="field-label">目标比例</view><picker range="{{ratioOptions}}" range-key="label" value="{{ratioIndex}}" bindchange="onRatioChange"><view class="picker-value">{{ratioOptions[ratioIndex].label || '不可用'}}</view></picker></view><view><view class="field-label">清晰度</view><picker range="{{resolutionOptions}}" range-key="label" value="{{resolutionIndex}}" bindchange="onResolutionChange"><view class="picker-value">{{resolutionOptions[resolutionIndex].label || '不可用'}}</view></picker></view></view>
    <button class="primary-button" loading="{{isSubmitting}}" disabled="{{!canSubmit}}" bindtap="submitRefine">提交精修</button><view class="submit-tip" wx:if="{{!canSubmit}}">请登录，选好源图与精修模型，填写指令及所需渠道密钥。</view><view class="error-box" wx:if="{{error}}">{{error}}</view>
  </view>
  <view class="section" wx:if="{{currentJobId}}">
    <view class="section-head"><view class="section-title">精修结果 · {{job.status_text || '排队中'}}</view><button size="mini" class="ghost-button" bindtap="refreshCurrentJob">刷新</button><button size="mini" class="ghost-button" bindtap="openJobDetail">详情</button></view>
    <view class="result-grid" wx:if="{{job.result_images.length}}"><view wx:for="{{job.result_images}}" wx:key="url" class="refine-result"><image class="result-image" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" bindtap="previewImage" /><view class="source-name">{{item.filename}}</view><view class="source-actions"><button size="mini" data-url="{{item.url}}" bindtap="saveImage">保存图片</button><button size="mini" data-url="{{item.url}}" bindtap="shareImage">发送文件</button></view></view></view>
    <view class="empty-state" wx:else>{{job.status_text || '任务已受理，正在等待结果。'}}</view>
    <stage-timeline stages="{{job.stages}}" references="{{job.retrieved_references}}" />
  </view>
  <view class="footer-space"></view>
</scroll-view>
<auth-panel show="{{showAuthPanel}}" bind:close="closeAuthPanel" bind:authed="onAuthed" />
<generation-settings-sheet purpose="{{settingsPurpose}}" show="{{showSettings}}" registry-version="{{registryVersion}}" settings="{{settings}}" api-keys="{{apiKeysForSheet}}" execution-roles="{{settingsExecutionRoles}}" bind:close="closeSettings" bind:save="saveSettings" />
