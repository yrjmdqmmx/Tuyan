<scroll-view class="page refine-page" scroll-y type="list">
  <view class="refine-hero"><view class="refine-kicker">INDEPENDENT REFINE</view><view class="refine-title">精修你的研究图示</view><view class="refine-sub">从本人任务结果继续编辑；源文件优先通过 objectKey 锁定，签名链接仅用于预览。</view></view>
  <view class="registry-banner ready" wx:if="{{registryReady}}">模型目录 {{registryVersion}}</view><view class="registry-banner error" wx:else>{{registryError || '正在读取模型目录'}}<button class="registry-retry" bindtap="retryRegistry">重试</button></view>
  <view class="section">
    <view class="section-head"><view><view class="section-title">选择源图</view><view class="section-note">本机任务与登录账号任务均可作为来源，Gateway 会再次校验所有权。</view></view><button wx:if="{{!isLoggedIn && !isAuthChecking}}" class="ghost-button" size="mini" bindtap="openAuthPanel">登录</button></view>
    <picker wx:if="{{sourceOptions.length}}" range="{{sourceOptions}}" range-key="label" value="{{sourceIndex}}" bindchange="onSourceChange"><view class="picker-value">{{sourceOptions[sourceIndex].label}}</view></picker>
    <view class="empty-state" wx:else>暂无可精修结果，请先完成一次 PNG 生成。</view>
    <image wx:if="{{source.url}}" class="refine-preview" src="{{source.url}}" mode="widthFix" />
  </view>
  <view class="section">
    <view class="refine-route"><view><view class="field-label">当前精修能力</view><view class="refine-mode">{{refineModeLabel}}</view></view><button class="ghost-button" size="mini" bindtap="openSettings">模型与密钥</button></view>
    <view class="field"><view class="field-label">精修指令</view><textarea class="textarea refine-instruction" maxlength="3000" value="{{instruction}}" placeholder="例如：放大标签、减少装饰、保持结构不变并让流程箭头更清晰。" bindinput="onInstructionInput" /></view>
    <view class="refine-grid"><view><view class="field-label">目标比例</view><picker range="{{ratioOptions}}" range-key="label" value="{{ratioIndex}}" bindchange="onRatioChange"><view class="picker-value">{{ratioOptions[ratioIndex].label || '不可用'}}</view></picker></view><view><view class="field-label">清晰度</view><picker range="{{resolutionOptions}}" range-key="label" value="{{resolutionIndex}}" bindchange="onResolutionChange"><view class="picker-value">{{resolutionOptions[resolutionIndex].label || '不可用'}}</view></picker></view></view>
    <button class="primary-button" loading="{{isSubmitting}}" disabled="{{!canSubmit}}" bindtap="submitRefine">提交精修</button><view class="submit-tip" wx:if="{{!canSubmit}}">请选择支持精修的模型、来源、比例和清晰度，并填写本次可达渠道密钥。</view><view class="error-box" wx:if="{{error}}">{{error}}</view>
  </view>
  <view class="section" wx:if="{{job}}"><view class="section-title">精修结果 · {{job.status_text}}</view><view class="result-grid" wx:if="{{job.result_images.length}}"><image wx:for="{{job.result_images}}" wx:key="url" class="result-image" src="{{item.url}}" mode="widthFix" /></view><stage-timeline stages="{{job.stages}}" references="{{job.retrieved_references}}" /></view>
  <view class="footer-space"></view>
</scroll-view>
<auth-panel show="{{showAuthPanel}}" bind:close="closeAuthPanel" bind:authed="onAuthed" />
<generation-settings-sheet show="{{showSettings}}" registry="{{registry}}" settings="{{settings}}" api-keys="{{apiKeysForSheet}}" execution-roles="{{settingsExecutionRoles}}" bind:close="closeSettings" bind:save="saveSettings" />
