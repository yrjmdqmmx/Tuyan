page{background:#f6f5ef;color:#253d33}.watcha-page{padding:32rpx 28rpx 80rpx}.watcha-card{padding:32rpx;background:#fffffb;border:1rpx solid #e2e6dc;border-radius:28rpx;margin-bottom:28rpx}.watcha-heading{display:flex;gap:20rpx;align-items:center;margin-bottom:24rpx}.watcha-mark{width:72rpx;height:72rpx;flex-shrink:0}.watcha-title{font-size:36rpx;font-weight:650}.watcha-subtitle{font-size:25rpx;color:#6e7d72;word-break:break-all}.watcha-note{font-size:27rpx;line-height:1.8;color:#667568;margin:20rpx 0}.watcha-step{font-size:29rpx;font-weight:600;margin:30rpx 0 18rpx}.watcha-input{box-sizing:border-box;width:100%;height:90rpx;padding:20rpx 24rpx;border:1rpx solid #d9dfd5;border-radius:16rpx;background:#fafaf5;font-size:29rpx;margin:18rpx 0}.watcha-primary,.watcha-secondary,.watcha-text{font-size:28rpx;line-height:1.6;padding:21rpx 20rpx;margin:20rpx 0;border-radius:18rpx;white-space:normal}.watcha-primary{background:#315f51;color:#fff}.watcha-secondary{background:#eef1e9;color:#315f51}.watcha-text{background:transparent;color:#567367;padding:14rpx}.watcha-text::after{border:0}button[disabled]{opacity:.5}.watcha-notice,.watcha-error{padding:20rpx;border-radius:14rpx;font-size:26rpx;line-height:1.7;word-break:break-word}.watcha-notice{background:#edf3ea;color:#315f51}.watcha-error{background:#faeee7;color:#9c4536}
