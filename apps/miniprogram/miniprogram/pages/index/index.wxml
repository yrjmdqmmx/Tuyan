<scroll-view class="page workbench-page" scroll-y type="list">
  <view class="paper-header tuyan-header">
    <view class="brand">
      <image class="brand-logo" src="{{logoSrc}}" mode="aspectFill" />
      <view class="brand-copy">
        <view class="brand-title">图研Tuyan</view>
        <view class="brand-sub">开源学术图示工作台</view>
      </view>
    </view>
    <view class="auth-chip logged" wx:if="{{isLoggedIn}}">
      <text class="auth-dot"></text><text class="auth-email">{{currentUserEmail}}</text><text class="auth-signout" bindtap="signOut">退出</text>
    </view>
    <button class="auth-chip" wx:else bindtap="openAuthPanel">登录 / 注册</button>
  </view>

  <view class="registry-banner ready" wx:if="{{registryReady}}">
    <view class="registry-message"><text class="registry-dot"></text>模型目录 {{registryVersion}}</view><text class="registry-meta">香港生产 API</text>
  </view>
  <view class="registry-banner error" wx:else>
    <view class="registry-message"><text class="registry-dot"></text>{{registryError || '正在读取服务端模型目录…'}}</view><button class="registry-retry" bindtap="retryRegistry">重试</button>
  </view>
  <view class="health-banner" wx:if="{{healthChecked && !healthOk}}">{{healthText}}</view>

  <featured-template-studio templates="{{featuredTemplates}}" loading="{{featuredTemplatesLoading}}" bind:apply="onFeaturedTemplateApply" />

  <view class="settings-summary-card" bindtap="openGenerationSettings">
    <view class="summary-icon">研</view>
    <view class="summary-copy">
      <view class="summary-kicker">当前生成设置</view>
      <view class="summary-value">{{settingsSummary}}</view>
      <view class="summary-note">点击调整 API 渠道、模型、比例、格式与清晰度</view>
    </view>
    <view class="summary-arrow">›</view>
  </view>

  <view class="section input-workspace">
    <view class="section-head">
      <view><view class="section-title">描述你的研究图示</view><view class="section-note">把研究方法与图注写清楚，图研会把内容组织成可投稿的视觉结构。</view></view>
      <view class="draft-state">自动保留</view>
    </view>

    <view class="field">
      <view class="field-label">图示类别</view>
      <picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">{{categoryLabel}}<text class="picker-arrow">›</text></view>
      </picker>
      <view class="field-tip">{{categoryDescription}}</view>
      <view class="plot-note" wx:if="{{isPlotCategory}}">{{plotNote}}</view>
    </view>

    <view class="field">
      <view class="field-label-row"><view class="field-label">研究方法与流程</view><view class="field-count">{{methodContent.length}} / 12000</view></view>
      <textarea class="textarea method-textarea-v1" maxlength="12000" show-confirm-bar="{{false}}" cursor-spacing="20" value="{{methodContent}}" placeholder="粘贴论文方法部分，描述模块、数据流、实验步骤与输入输出…" bindinput="onMethodInput" />
    </view>

    <view class="field">
      <view class="field-label-row"><view class="field-label">目标图注</view><view class="field-count">{{caption.length}} / 1000</view></view>
      <textarea class="textarea caption-textarea" maxlength="1000" show-confirm-bar="{{false}}" value="{{caption}}" placeholder="例如：图 1：所提出方法框架总览。" bindinput="onCaptionInput" />
    </view>

    <view class="field negative-field">
      <view class="field-label-row"><view class="field-label">负向提示词 <text class="field-optional">可选</text></view><view class="field-count">{{negativePrompt.length}} / 1000</view></view>
      <textarea class="textarea negative-textarea" maxlength="1000" show-confirm-bar="{{false}}" value="{{negativePrompt}}" placeholder="例如：避免过密文字、装饰性背景、模糊箭头与无法辨认的小字号。" bindinput="onNegativePromptInput" />
    </view>

    <view class="reference-shell">
      <view class="reference-upload-head">
        <view><view class="field-label">参考来源</view><view class="field-tip">上传参考图与图库检索互斥；所有权和文件类型会由 Gateway 校验。</view></view>
        <button wx:if="{{!showReferenceLibrary}}" class="ghost-button" size="mini" disabled="{{!referenceCanAddImage || isSubmitting || isUploadingReferences}}" bindtap="chooseReferenceFile">{{isUploadingReferences ? '上传中' : '添加参考图'}}</button>
      </view>
      <view class="reference-mode-chip" wx:if="{{showReferenceLibrary}}">当前使用参考图库</view>
      <view class="reference-preview-grid" wx:if="{{referenceImages.length}}">
        <view class="reference-card" wx:for="{{referenceImages}}" wx:key="id">
          <image wx:if="{{item.canPreview}}" class="reference-thumb" src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="previewReferenceImage" />
          <view wx:else class="reference-file-thumb">{{item.formatText}}</view>
          <view class="reference-info"><text>{{item.filename}}</text><text>{{item.sizeText}}</text></view>
          <button class="reference-remove" size="mini" data-id="{{item.id}}" bindtap="removeReferenceImage">移除</button>
        </view>
      </view>
      <view class="reference-mode-panel" wx:if="{{shouldShowReferenceModeSelector}}">
        <view class="field-label">参考图处理方式</view>
        <view class="reference-mode-switch"><button wx:for="{{referenceImageModeOptions}}" wx:key="value" class="{{referenceImageMode === item.value ? 'active' : ''}} {{item.value === 'main_model' && !canSelectMainModelDirect ? 'disabled' : ''}}" data-mode="{{item.value}}" bindtap="onReferenceModeTap">{{item.label}}</button></view>
      </view>
      <view class="field-tip" wx:if="{{referenceModeNote}}">{{referenceModeNote}}</view>
      <view wx:if="{{referenceUploadError}}" class="error-box">{{referenceUploadError}}</view>
      <reference-library wx:if="{{showReferenceLibrary}}" task-name="{{libraryTaskName}}" selected-ids="{{manualReferenceIds}}" bind:toggle="onManualReferenceToggle" />
    </view>

    <button class="primary-button generate-button" loading="{{isSubmitting}}" disabled="{{!canSubmit}}" bindtap="submitJob">{{isUploadingReferences ? '正在上传参考图' : (isSubmitting ? '正在提交' : '生成学术图示')}}</button>
    <view wx:if="{{!canSubmit}}" class="submit-tip">请确认模型目录可用、填写本次可达渠道的 API Key，并完成至少 20 字方法内容与图注。</view>
    <view wx:if="{{error}}" class="error-box">{{error}}</view>
  </view>

  <view class="section result-section" wx:if="{{currentJobId}}">
    <view class="section-head"><view><view class="section-title">生成结果</view><view class="section-note">任务 ID：{{currentJobId}}</view></view><button class="ghost-button" size="mini" bindtap="openJobDetail">查看详情</button></view>
    <view class="job-panel"><view class="job-badges"><view class="status-badge {{job.status || 'queued'}}">{{statusLabel || '排队中'}}</view><view class="status-pill">{{settings.aspectRatio}}</view><view class="status-pill">{{settings.outputFormat}}</view></view><button class="ghost-button" size="mini" bindtap="refreshCurrentJob">刷新</button></view>
    <view class="result-grid" wx:if="{{resultImages.length}}">
      <view class="asset-card" wx:for="{{resultImages}}" wx:key="url">
        <image wx:if="{{item.can_preview}}" class="result-image" src="{{item.url}}" mode="widthFix" data-url="{{item.url}}" data-can-preview="{{item.can_preview}}" bindtap="previewImage" />
        <view wx:else class="file-asset"><view class="file-asset-format">{{item.format_text}}</view><view class="file-asset-name">{{item.filename}}</view></view>
        <view class="asset-actions"><text>{{item.filename}}</text><button size="mini" data-url="{{item.url}}" data-can-preview="{{item.can_preview}}" catchtap="handleImageAction">{{item.action_label}}</button></view>
      </view>
    </view>
    <view class="empty-state" wx:else><view>{{statusLabel || '等待结果'}}</view><text>任务完成后会在这里显示候选图。</text></view>
    <stage-timeline wx:if="{{job}}" stages="{{job.stages}}" references="{{job.retrieved_references}}" />
  </view>

  <view class="footer-space"></view>
</scroll-view>

<auth-panel show="{{showAuthPanel}}" bind:close="closeAuthPanel" bind:authed="onAuthed" />
<feedback-panel show="{{showFeedbackPanel}}" job-id="{{currentJobId}}" bind:close="closeFeedbackPanel" />
<generation-settings-sheet show="{{showGenerationSettings}}" registry="{{registry}}" settings="{{settings}}" api-keys="{{apiKeysForSheet}}" execution-roles="{{settingsExecutionRoles}}" bind:close="closeGenerationSettings" bind:save="saveGenerationSettings" />

<movable-area class="fab-area"><movable-view class="feedback-fab" direction="all" x="{{fabX}}" y="{{fabY}}" inertia bindtap="openFeedbackPanel">反馈</movable-view></movable-area>
