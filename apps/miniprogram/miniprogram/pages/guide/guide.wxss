.guide-page{background:radial-gradient(circle at 90% 0,#d8eadd,transparent 380rpx),#f3f2ee}.guide-hero{margin:24rpx;padding:36rpx;border-radius:30rpx;background:linear-gradient(145deg,#173d35,#2f6b59);color:#fff;box-shadow:0 22rpx 44rpx rgba(29,68,56,.22)}.guide-kicker{color:#dfc37b;font-size:18rpx;font-weight:850;letter-spacing:3rpx}.guide-hero-title{margin-top:10rpx;font-size:40rpx;font-weight:880}.guide-hero-note{margin-top:12rpx;color:rgba(255,255,255,.76);font-size:22rpx;line-height:1.65}.guide-actions{display:grid;grid-template-columns:1.3fr 1fr;gap:12rpx;margin-top:24rpx}.guide-action{margin:0;border-radius:14rpx;background:#dabe76;color:#193b32;font-size:22rpx;font-weight:820}.guide-action.secondary{border:1rpx solid rgba(255,255,255,.32);background:transparent;color:#fff}.registry-card{margin:0 24rpx;padding:22rpx;border:1rpx solid #ccd8cf;border-radius:20rpx;background:rgba(255,255,252,.94)}.registry-row{display:grid;grid-template-columns:150rpx 1fr;gap:16rpx;padding:9rpx 0}.registry-label{color:#68736d;font-size:20rpx}.registry-value{font-size:20rpx;font-weight:700;line-height:1.5;word-break:break-all}.registry-error{margin-top:10rpx;color:#a04432;font-size:20rpx}.chapter-list{margin:22rpx 24rpx 0}.chapter{margin-bottom:12rpx;overflow:hidden;border:1rpx solid #d8ddd7;border-radius:19rpx;background:rgba(255,255,252,.95)}.chapter-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:22rpx}.chapter-title{font-size:26rpx;font-weight:830}.chapter-summary{margin-top:6rpx;color:#79817d;font-size:19rpx;line-height:1.45}.chapter-arrow{flex:none;color:#2d6352;font-size:36rpx}.chapter-body{padding:0 22rpx 24rpx;border-top:1rpx solid #edf0ec}.step{display:grid;grid-template-columns:46rpx 1fr;gap:14rpx;margin-top:20rpx}.step-number{display:grid;place-items:center;width:46rpx;height:46rpx;border-radius:50%;background:#2d6252;color:#fff;font-size:21rpx;font-weight:850}.step-title{font-size:22rpx;font-weight:700}.step-copy{margin-top:5rpx;color:#66716b;font-size:20rpx;line-height:1.55}.setting-card{margin-top:14rpx;padding:16rpx;border:1rpx solid #e0e3de;border-radius:13rpx;background:#fafbf8}.setting-card-title{font-size:22rpx;font-weight:800}.setting-card-copy{display:block;margin-top:6rpx;color:#69736e;font-size:20rpx;line-height:1.6}.guide-copy{margin-top:18rpx;color:#56625c;font-size:21rpx;line-height:1.7}.guide-section-title{font-size:28rpx;font-weight:850}.contact-qr{display:block;width:420rpx;margin:20rpx auto 0;border-radius:18rpx}.about-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:16rpx}.about-label,.about-value{font-size:22rpx}.about-button{margin:0;height:52rpx;line-height:52rpx;font-size:19rpx}.footer-space{height:160rpx}
