.sheet-mask{position:fixed;inset:0;z-index:180;display:flex;align-items:flex-end;background:rgba(14,22,19,.52)}.settings-sheet{width:100%;height:90vh;box-sizing:border-box;padding:14rpx 28rpx 0;border-radius:32rpx 32rpx 0 0;background:#f8f7f2}.sheet-handle{width:72rpx;height:7rpx;margin:0 auto 18rpx;border-radius:999rpx;background:#c7cbc5}.sheet-head{display:flex;align-items:center;justify-content:space-between}.sheet-title{font-size:34rpx;font-weight:850}.sheet-note{margin-top:5rpx;color:#7a817d;font-size:20rpx}.sheet-cancel{margin:0;height:58rpx;padding:0 22rpx;border-radius:999rpx;font-size:21rpx;line-height:58rpx}.sheet-scroll{height:calc(90vh - 170rpx);margin-top:20rpx}.setting-label{margin-bottom:10rpx;color:#575f5b;font-size:21rpx;font-weight:760}.setting-block{margin-top:24rpx}.mode-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8rpx;padding:6rpx;border-radius:16rpx;background:#e8ebe5}.mode-tab{margin:0;border-radius:12rpx;background:transparent;color:#69716d;font-size:23rpx}.mode-tab.active{background:#285c4c;color:#fff}.route-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:10rpx;padding:18rpx;border:1rpx solid #d8dcd5;border-radius:15rpx;background:#fff}.route-role{font-size:21rpx;font-weight:780}.route-provider{margin-top:4rpx;color:#6a7c74;font-size:18rpx}.route-model{max-width:400rpx;text-align:right;font-size:21rpx;font-weight:700}.route-arrow{margin-left:12rpx;color:#2d6755;font-size:30rpx}.setting-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.setting-picker{box-sizing:border-box;height:70rpx;padding:0 16rpx;border:1rpx solid #d8dcd5;border-radius:13rpx;background:#fff;font-size:22rpx;line-height:70rpx}.key-field{margin-bottom:13rpx}.key-label{margin-bottom:7rpx;color:#626b66;font-size:20rpx}.key-input{height:70rpx;padding:0 16rpx;border:1rpx solid #d8dcd5;border-radius:13rpx;background:#fff;font-size:22rpx}.privacy-note{color:#7b817d;font-size:19rpx;line-height:1.5}.sheet-error{margin-top:20rpx;color:#a33f31;font-size:21rpx}.sheet-bottom-space{height:130rpx}.sheet-save{position:absolute;left:28rpx;right:28rpx;bottom:calc(20rpx + env(safe-area-inset-bottom));height:82rpx;border-radius:18rpx;background:#245546;color:#fff;font-size:25rpx;font-weight:820;line-height:82rpx;box-shadow:0 16rpx 30rpx rgba(26,71,57,.24)}
.ark-verify{margin:16rpx 0 0;border:1rpx solid #dfc16f;border-radius:13rpx;background:#fff6d9;color:#7d5a0e;font-size:20rpx;font-weight:780}
