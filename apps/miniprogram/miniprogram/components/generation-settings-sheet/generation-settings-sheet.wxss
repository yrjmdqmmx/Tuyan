.sheet-mask{position:fixed;top:0;left:0;right:0;bottom:0;z-index:180;display:flex;align-items:flex-end;background:rgba(20,37,30,.4)}.settings-sheet{display:flex;flex-direction:column;width:100%;height:94%;max-height:850px;min-height:0;box-sizing:border-box;padding:8px 16px 0;border-radius:20px 20px 0 0;background:#fbfaf7}.sheet-handle{flex:none;width:32px;height:3px;margin:0 auto 12px;border-radius:3px;background:#cad1ca}.sheet-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex:none;padding-bottom:14px;border-bottom:1px solid #e5e7e0}.sheet-title{font-size:18px;font-weight:700;color:#243e33}.sheet-note{margin-top:4px;color:#7a867e;font-size:11px}.sheet-head .sheet-cancel{width:auto;min-width:56px;height:44px;min-height:44px;margin:0;padding:0 10px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:transparent;color:#53685b;font-size:13px;line-height:1.2}.sheet-scroll{height:0;flex:1;min-height:0}.sheet-content{padding:2px 0 12px}.setting-section{padding:18px 0;border-bottom:1px solid #e5e7e0}.setting-heading{margin-bottom:12px;color:#273d32;font-size:15px;font-weight:700}.setting-label{margin-bottom:8px;color:#637067;font-size:12px;font-weight:500}.mode-tabs{display:flex;gap:4px;padding:4px;background:#edf0e9;border-radius:10px}.mode-tabs .mode-tab{width:50%;margin:0;min-height:40px;display:flex;align-items:center;justify-content:center;padding:8px;border-radius:7px;background:transparent;color:#667269;font-size:13px;line-height:1.2}.mode-tabs .active{background:#315f51;color:white}.channel-line{display:flex;align-items:center;justify-content:space-between;min-height:48px;gap:10px}.channel-line .setting-label{margin:0}.channel-value{min-height:44px;display:flex;align-items:center;gap:12px;color:#315f51;font-size:13px}.route-row{display:flex;align-items:center;gap:8px;min-height:58px;border-top:1px solid #eceee7}.route-copy{flex:1;min-width:0}.route-role{font-size:12px;color:#69736d}.route-provider{font-size:10px;color:#7f8d83;margin-top:4px}.route-model{max-width:58%;font-size:13px;line-height:1.45;color:#2b4537;font-weight:600;word-break:break-word}.route-arrow{color:#789282;font-size:22px}.setting-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.setting-picker,.key-input{box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;width:100%;height:44px;min-height:44px;padding:0 12px;border:1px solid #dce1d8;border-radius:8px;background:#fff;font-size:13px;line-height:normal;color:#2d3d32}.setting-block{margin-top:16px}.settings-sheet .disclosure{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:48px;box-sizing:border-box;margin:6px 0;padding:0;background:transparent;font-size:12px;color:#68776d;line-height:1.4;text-align:left}.credentials-heading{margin:0;min-height:32px}.credentials-heading .setting-heading{margin:0}.credential-summary,.credential-status{font-size:12px;line-height:1.6;color:#607b69}.credential-status{padding:12px;background:#eef4ed;border-radius:8px}.privacy-note{font-size:11px;line-height:1.6;color:#829086;margin-top:10px;word-break:break-word}.key-field{margin-top:16px}.retrieval-options{display:grid;grid-template-columns:1fr 1fr;gap:8px}.retrieval-options .retrieval-option{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-height:44px;padding:8px 6px;margin:0;border:1px solid #dce1d8;border-radius:8px;background:white;color:#57665a;font-size:12px;line-height:1.3}.retrieval-options .active{border-color:#315f51;color:#244f43;background:#e9f2eb}.manual-library{margin-top:16px}.sheet-error,.adjustment-note{padding:12px;margin:12px 0;color:#9b4535;background:#fff0e9;border-radius:8px;font-size:12px;line-height:1.5}.adjustment-note{color:#776535;background:#f6f2e5}.sheet-footer{flex:none;box-sizing:border-box;padding:10px 0 max(10px,env(safe-area-inset-bottom));border-top:1px solid #e3e8de;background:#fbfaf7}.sheet-footer .sheet-save{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;height:44px;min-height:44px;margin:0;padding:0 16px;border-radius:10px;background:#315f51;color:#fff;font-size:14px;font-weight:600;line-height:1.2;box-shadow:none}.settings-sheet .ark-verify{font-size:12px;color:#715c2b;background:#f5edcf;min-height:44px;line-height:1.4;padding:10px}.sheet-cancel::after,.sheet-save::after,.mode-tab::after,.disclosure::after,.retrieval-option::after,.ark-verify::after{border:0}

.settings-sheet.keyboard-open .sheet-footer{padding-bottom:10px}

.role-config{padding:6px 0 12px;border-bottom:1px solid #e1e7df}.role-config .route-row{border:0;padding-bottom:8px}.role-credential{display:flex;align-items:center;gap:8px}.role-credential-copy{flex:1;min-width:0}.credential-state{font-size:12px;line-height:1.5}.credential-state.ready{color:#2d7252}.credential-state.missing{color:#a15c27}.role-usage{font-size:11px;color:#7b877d;line-height:1.5}.settings-sheet .role-key-button{width:auto;flex:none;min-width:0;margin:0;padding:8px;background:#edf3ed;color:#2e624c;font-size:12px;line-height:1.4;border-radius:8px}.role-key-button::after{border:0}.credential-summary{line-height:1.6;color:#986127}.settings-sheet .key-input{font-size:16px}
