.account-mask{position:fixed;inset:0;z-index:230;display:flex;align-items:flex-end;background:rgba(14,20,18,.58)}.account-sheet{width:100%;height:82vh;box-sizing:border-box;padding:28rpx;border-radius:30rpx 30rpx 0 0;background:#f8f7f2}.account-head{display:flex;align-items:center;justify-content:space-between}.account-title{font-size:34rpx;font-weight:850}.account-email{margin-top:6rpx;color:#737d78;font-size:20rpx}.account-close{margin:0;height:56rpx;line-height:56rpx;font-size:20rpx}.account-scroll{height:calc(82vh - 100rpx);margin-top:22rpx}.privacy-card{padding:20rpx;border:1rpx solid #cadccf;border-radius:17rpx;background:#eef6f0;color:#52625b;font-size:21rpx;line-height:1.65}.privacy-title{margin-bottom:8rpx;color:#2c604f;font-size:24rpx;font-weight:800}.logout-button{margin:20rpx 0 0;border:1rpx solid #ccd3ce;border-radius:15rpx;background:#fff;color:#33423b}.danger-zone{margin-top:26rpx;padding:22rpx;border:1rpx solid #e6c8bd;border-radius:18rpx;background:#fff8f4}.danger-title{color:#993d30;font-size:26rpx;font-weight:850}.danger-note{margin-top:8rpx;color:#7c6963;font-size:20rpx;line-height:1.6}.danger-input{height:72rpx;margin-top:14rpx;padding:0 16rpx;border:1rpx solid #dfd3ce;border-radius:12rpx;background:#fff;font-size:22rpx}.danger-confirm{display:flex;align-items:center;gap:8rpx;margin-top:18rpx;color:#735d56;font-size:20rpx}.delete-button{margin:20rpx 0 0;border-radius:14rpx;background:#a54334;color:#fff}.account-error{margin-top:14rpx;color:#a13e30;font-size:20rpx}
