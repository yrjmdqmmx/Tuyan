<view wx:if="{{show}}" class="account-mask" catchtouchmove="noop" catchtap="close">
  <view class="account-sheet" catchtap="noop" role="dialog" aria-label="账户与安全">
    <view class="account-head">
      <view class="account-heading"><view class="account-kicker">图研 Tuyan</view><view class="account-title">账户与安全</view><view class="account-email">{{currentEmail}}</view></view>
      <button class="account-close" aria-label="关闭账户与安全" bindtap="close">关闭</button>
    </view>
    <scroll-view class="account-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="security-card">
        <view class="security-card-head"><view><view class="security-eyebrow">账号安全</view><view class="security-title">邮箱验证</view></view><view class="verify-badge {{emailVerified ? 'verified' : 'pending'}}">{{emailVerified ? '已验证' : '待验证'}}</view></view>
        <view class="security-copy" wx:if="{{emailVerified}}">邮箱已验证，可用于安全通知和找回密码。</view>
        <view class="security-copy" wx:else>当前会话可以继续使用。建议完成验证，以便安全找回账号。</view>
        <button wx:if="{{!emailVerified}}" class="resend-button" loading="{{resendingVerification}}" disabled="{{resendDisabled || resendingVerification}}" bindtap="resendVerification">{{resendCooldownSeconds > 0 ? resendCooldownSeconds + ' 秒后可重发' : '重发验证邮件'}}</button>
      </view>

      <view class="security-section">
        <view class="security-title">修改密码</view>
        <view class="security-copy">新密码为 8–128 位。更新后会撤销其他设备上的会话。</view>
        <input class="security-input" password value="{{currentPassword}}" placeholder="当前密码" aria-label="当前密码" bindinput="onCurrentPasswordInput" />
        <input class="security-input" password maxlength="128" value="{{newPassword}}" placeholder="新密码（8–128 位）" aria-label="新密码，8 到 128 位" bindinput="onNewPasswordInput" />
        <input class="security-input" password maxlength="128" value="{{confirmPassword}}" placeholder="再次输入新密码" aria-label="再次输入新密码" bindinput="onConfirmPasswordInput" />
        <view class="account-error" wx:if="{{changePasswordError}}" aria-label="修改密码失败">{{changePasswordError}}</view>
        <button class="change-password-button" loading="{{changingPassword}}" disabled="{{changingPassword || changePasswordCooldownSeconds > 0}}" bindtap="submitChangePassword">{{changePasswordCooldownSeconds > 0 ? changePasswordCooldownSeconds + ' 秒后重试' : '更新密码'}}</button>
      </view>

      <view class="security-message success" wx:if="{{securityStatus}}" aria-label="操作成功">{{securityStatus}}</view>
      <view class="security-message error" wx:if="{{securityError}}" aria-label="操作失败">{{securityError}}</view>
      <view class="privacy-card"><view class="privacy-title">隐私说明</view><view>图研Tuyan 仅为登录、任务所有权与结果资产保存处理必要账号信息。API Key 只存在当前页面内存，不进入 Storage、日志或任务记录。</view></view>
      <button class="logout-button" bindtap="logout">退出当前账号</button>
      <view class="danger-zone">
        <view class="danger-title">永久删除账号</view>
        <view class="danger-note">删除前必须重输当前邮箱和密码，并完成二次确认。成功后会清理 Cookie、草稿、任务缓存和内存密钥。</view>
        <input class="danger-input" value="{{email}}" placeholder="重输当前邮箱" aria-label="删除账号确认邮箱" bindinput="onEmailInput" />
        <input class="danger-input" password value="{{password}}" placeholder="重输当前密码" aria-label="删除账号确认密码" bindinput="onPasswordInput" />
        <checkbox-group bindchange="onConfirmChange"><label class="danger-confirm"><checkbox value="confirmed" checked="{{confirmed}}" color="#9c3e31" />我理解删除不可撤销</label></checkbox-group>
        <view class="account-error" wx:if="{{error}}" aria-label="删除账号失败">{{error}}</view>
        <button class="delete-button" loading="{{deleting}}" disabled="{{deleting}}" bindtap="deleteAccount">永久删除账号</button>
      </view>
      <view class="account-safe-space" />
    </scroll-view>
  </view>
</view>
