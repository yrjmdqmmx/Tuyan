.template-studio { padding: 28rpx 0 30rpx; border-radius: 30rpx; background: linear-gradient(145deg,#173d35,#285d4e 70%,#396f5c); color:#fff; overflow:hidden; box-shadow:0 22rpx 46rpx rgba(26,66,55,.22); }
.studio-head { display:flex; justify-content:space-between; gap:24rpx; padding:0 28rpx; }
.studio-kicker { color:#d9bc72; font-size:18rpx; font-weight:800; letter-spacing:3rpx; }
.studio-title { margin-top:8rpx; font-size:36rpx; font-weight:850; }
.studio-note { margin-top:8rpx; max-width:520rpx; color:rgba(255,255,255,.74); font-size:22rpx; line-height:1.5; }
.studio-count { flex:none; align-self:flex-start; padding:8rpx 16rpx; border:1rpx solid rgba(255,255,255,.26); border-radius:999rpx; color:#f2ddaa; font-size:20rpx; }
.template-scroll { margin-top:24rpx; width:100%; }
.template-track { display:inline-flex; gap:18rpx; padding:0 28rpx 4rpx; }
.template-card { width:430rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.18); border-radius:22rpx; background:#fffdf8; color:#18211e; box-shadow:0 14rpx 28rpx rgba(0,0,0,.16); }
.template-image,.template-fallback { display:block; width:430rpx; height:230rpx; background:#e8eee8; }
.template-fallback { box-sizing:border-box; display:grid; align-content:center; gap:18rpx; padding:34rpx; background:linear-gradient(145deg,#eef3ed,#dce8df); }
.fallback-row { display:flex; align-items:center; gap:12rpx; }
.fallback-node { width:92rpx; height:38rpx; border:2rpx solid #548071; border-radius:8rpx; background:#fff; }
.fallback-node.wide { width:190rpx; justify-self:center; }
.fallback-line { width:92rpx; height:2rpx; background:#91aa9f; }
.template-body { padding:20rpx; }
.template-title { font-size:27rpx; font-weight:830; }
.template-summary { min-height:66rpx; margin-top:8rpx; color:#66706c; font-size:21rpx; line-height:1.55; }
.template-apply { margin:18rpx 0 0; height:62rpx; border-radius:13rpx; background:#244f43; color:#fff; font-size:22rpx; font-weight:780; line-height:62rpx; }
