.template-studio{padding:16px 12px 6px;border-radius:16px;background:#295b4b;overflow:hidden}.studio-head{display:flex;align-items:flex-start;gap:10px;padding:0 2px 12px}.studio-copy{flex:1;min-width:0}.studio-title{font-size:17px;font-weight:750;color:#fff;line-height:1.4}.studio-note{margin-top:5px;font-size:11px;color:#c8dcd0;line-height:1.5}.studio-count{flex:none;font-size:12px;line-height:24px;color:#ecd893}.template-swiper{width:100%;height:304px}.template-card{box-sizing:border-box;width:100%;height:278px;overflow:hidden;border-radius:12px;background:#fffdf6}.template-image{display:block;box-sizing:border-box;width:100%;height:142px;padding:10px;background:#fff}.template-fallback{display:flex;align-items:center;justify-content:center;color:#718e78;font-size:14px}.template-body{padding:10px 12px}.template-title{font-size:15px;line-height:1.4;font-weight:750;color:#243b2e}.template-summary{height:34px;margin-top:4px;overflow:hidden;font-size:12px;line-height:17px;color:#778575}.template-studio .template-apply{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;height:36px;min-width:0;padding:0;margin:8px 0 0;border-radius:8px;background:#eaf1e6;color:#285c43;font-size:13px;font-weight:700;line-height:36px}.template-apply::after{border:0}
