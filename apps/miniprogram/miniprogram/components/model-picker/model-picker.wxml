<import src="../../templates/model-unavailable.wxml"/>
<view wx:if="{{show}}" class="model-modal" catchtouchmove="noop">
  <view class="model-panel" catchtap="noop">
    <view class="model-head"><view class="model-head-copy"><view class="model-kicker">选择{{roleLabel}}</view><view class="model-note">仅显示当前角色可用模型</view></view><button class="model-close" bindtap="close">关闭</button></view>
    <view wx:if="{{removedHint}}" class="model-note model-unavailable-notice"><template is="model-unavailable" data="{{removed:removed}}"/><button wx:if="{{savedReplacement}}" class="secondary-button" bindtap="confirmReplacement">改选</button></view>
    <view wx:if="{{savedLifecycle}}" class="model-note">{{selectedModel}} · {{savedLifecycle}}<button wx:if="{{savedReplacement}}" bindtap="confirmReplacement">切换到 {{replacementLabel}}</button></view>
    <view class="model-steps">
      <button class="flow-step {{step === 'providers' ? 'active' : ''}}" bindtap="showProviders" aria-label="第1步 接入渠道{{step === 'providers' ? '，当前步骤' : ''}}">① 接入渠道</button><text class="flow-arrow">→</text>
      <button class="flow-step {{step === 'vendors' ? 'active' : ''}}" disabled="{{!activeProvider}}" bindtap="showVendors" aria-label="第2步 模型厂商{{step === 'vendors' ? '，当前步骤' : ''}}">② 模型厂商</button><text class="flow-arrow">→</text>
      <button class="flow-step {{step === 'models' ? 'active' : ''}}" disabled="{{!activeVendor}}" bindtap="showModels" aria-label="第3步 具体模型{{step === 'models' ? '，当前步骤' : ''}}">③ 具体模型</button>
    </view>
    <view class="model-path">{{activeProviderLabel ? activeProviderLabel + ' → ' + (activeVendor || '待选厂商') + (activeModelLabel ? ' → ' + activeModelLabel : '') : '请选择 API 接入渠道'}}</view>
    <view class="model-toolbar" wx:if="{{step !== 'providers'}}"><button class="step-back" bindtap="backStep">‹ 返回{{step === 'models' ? '模型厂商' : '接入渠道'}}</button><text class="step-caption">{{step === 'vendors' ? '选择模型厂商' : '选择具体模型'}}</text></view>
    <input wx:if="{{step === 'models'}}" class="model-search" value="{{query}}" placeholder="搜索当前厂商的型号或能力" bindinput="onSearch" />
    <scroll-view wx:if="{{step === 'providers'}}" class="model-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="provider-list">
        <button class="provider-card {{activeProvider === item.id ? 'current' : ''}}" wx:for="{{providerCards}}" wx:key="id" data-provider="{{item.id}}" bindtap="selectProvider"><view class="provider-copy"><view class="card-title">{{item.label}}</view><view class="card-note">{{item.kindText}}{{selectedProvider === item.id ? ' · 当前配置' : ''}}</view></view><view class="card-count">{{item.count}} 个可用 ›</view></button>
        <view class="model-empty" wx:if="{{!providerCards.length && !removedHint}}">当前角色暂无可用渠道，请检查模型目录。</view>
      </view>
    </scroll-view>
    <scroll-view wx:elif="{{step === 'vendors'}}" class="model-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="vendor-list"><view class="model-count">{{activeProviderLabel}} · {{vendorCards.length}} 个模型厂商</view>
        <button class="provider-card {{activeVendor === item.vendor ? 'current' : ''}}" wx:for="{{vendorCards}}" wx:key="vendor" data-vendor="{{item.vendor}}" bindtap="selectVendor"><view class="provider-copy"><view class="card-title">{{item.vendor}}</view><view class="card-note">通过{{activeProviderLabel}}接入</view></view><view class="card-count">{{item.count}} 个模型 ›</view></button>
      </view>
    </scroll-view>
    <scroll-view wx:else class="model-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="model-list">
        <view class="model-count">{{compatibleCount}} 个匹配模型 · 点击名称选择</view>
        <view class="model-row {{item.selected ? 'selected' : ''}} {{item.disabled ? 'is-paused' : ''}}" wx:for="{{visibleCompatibleModels}}" wx:key="id">
          <view class="model-main" data-model="{{item.id}}" bindtap="choose"><view class="model-name">{{item.label}}<text wx:if="{{item.scheduled}}" class="status-badge" data-url="{{item.retirementSource.url}}" data-source="{{item.retirementSource.label}}" data-notice="{{item.auditMessage}}" catchtap="copySource">将下线</text></view><view class="card-note">{{item.vendorLabel}} / {{item.channelLabel}}</view></view>
          <view class="model-toolbar"><text class="model-id" user-select data-model="{{item.id}}" catchtap="copyId" aria-label="复制 ID">{{item.id}}</text><text class="card-note">{{item.capabilityText}}</text></view>
          <view class="model-details model-audit-specs"><view wx:for="{{item.specRows}}" wx:for-item="spec" wx:key="label"><text>{{spec.label}}</text><view><view wx:if="{{spec.icons.length}}" class="modality-icons"><view wx:for="{{spec.icons}}" wx:for-item="icon" wx:key="id" class="modality-icon is-{{icon.state}}" data-state="{{icon.state}}" aria-role="button" aria-label="{{icon.accessibleLabel}}" data-label="{{spec.label}} · {{icon.accessibleLabel}}" data-detail="{{icon.tooltip}}" catchtap="showModality"><view class="modality-glyph glyph-{{icon.id}}" aria-hidden="true"/><view wx:if="{{icon.state === 'unsupported'}}" class="modality-strike" aria-hidden="true"/><text wx:if="{{icon.state === 'unknown' || icon.state === 'unlisted'}}" class="modality-question" aria-hidden="true">?</text><text wx:if="{{icon.state === 'conditional'}}" class="modality-question" aria-hidden="true">*</text></view></view><text wx:else class="{{spec.unknown ? 'card-note' : ''}}">{{spec.value}}</text><text wx:if="{{spec.origin}}" class="card-note"> · {{spec.origin}}</text></view></view></view>
          <view wx:if="{{item.disabled}}" class="card-note">{{item.disabledReason}}</view>
          <view class="model-toolbar"><text wx:if="{{!item.specSources.length}}" class="card-note">官方文档待确认</text><button class="model-copy model-source-link" wx:for="{{item.specSources}}" wx:for-item="source" wx:key="url" data-url="{{source.url}}" data-source="{{source.label}}" data-notice="{{item.auditMessage}}" catchtap="copySource">{{source.label}}<text class="source-copy-hint"> · 复制链接</text></button><button class="model-copy" disabled="{{item.disabled}}" data-model="{{item.id}}" bindtap="choose">{{item.selected ? '✓ 已选' : '选择'}}</button></view>
        </view>
        <button class="model-more" wx:if="{{hasMore}}" bindtap="loadMore">显示更多模型</button>
        <view class="model-empty" wx:if="{{!compatibleCount && !removedHint}}">没有匹配当前角色与输出格式的可用模型。</view>
      </view>
    </scroll-view>
  </view>
</view>
