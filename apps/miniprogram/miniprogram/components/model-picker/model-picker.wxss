.model-modal{position:fixed;inset:0;z-index:240;display:flex;align-items:flex-end;background:rgba(15,22,19,.58)}
.model-panel{display:flex;flex-direction:column;box-sizing:border-box;width:100%;height:92%;padding:18px 16px calc(12px + env(safe-area-inset-bottom));border-radius:22px 22px 0 0;background:#f8f7f2}
.model-head{display:flex;align-items:flex-start;gap:12px;padding-bottom:12px}.model-head-copy{flex:1;min-width:0}.model-kicker{font-size:18px;font-weight:750;color:#173b30}.model-note{margin-top:6px;font-size:12px;line-height:1.5;color:#68786e}
.model-panel .model-close{width:auto;flex:none;margin:0;padding:0 8px;height:36px;line-height:36px;font-size:13px;background:transparent;color:#285c4c}
.model-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px}.vendor-picker{min-width:0;max-width:58%}.vendor-filter{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;padding:10px;font-size:13px;color:#285c4c}
.model-panel .step-back{width:auto;flex:none;margin:0;padding:10px 0;font-size:13px;line-height:1.4;background:transparent;color:#285c4c}
.model-search{box-sizing:border-box;width:100%;height:42px;margin:8px 0;padding:0 12px;border:1px solid #d8ded8;border-radius:10px;background:white;font-size:14px}
.model-scroll{flex:1;min-height:0;height:0}.provider-list,.model-list{padding:6px 0 22px}
.model-panel .provider-card{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;width:100%;min-width:0;margin:0 0 8px;padding:14px 12px;border:1px solid #d8e0d9;border-radius:12px;background:#fff;text-align:left;line-height:1.4}
.provider-copy{flex:1;min-width:0}.card-title{font-size:16px;font-weight:700;color:#253a30;word-break:break-word}.card-note{margin-top:5px;font-size:12px;color:#728077;line-height:1.5;word-break:break-word}.card-count{flex:none;margin-left:12px;font-size:12px;color:#326453}.model-panel .provider-card.current{border-color:#67917e;background:#eef6f0}
.model-count{margin:6px 0 12px;font-size:12px;color:#748076}.model-row{box-sizing:border-box;width:100%;margin-bottom:10px;padding:12px;border:1px solid #dce3dc;border-radius:12px;background:#fff}.model-row.selected{border-color:#418168;background:#edf7f1}
.model-panel .model-select{display:flex;align-items:flex-start;gap:10px;width:100%;min-width:0;padding:0;margin:0;background:transparent;text-align:left;line-height:1.5}.model-main{flex:1;min-width:0}.model-name{font-size:16px;font-weight:750;color:#213b2f;word-break:break-word}.model-capability{font-size:12px;color:#6b7b70;margin-top:5px}.model-check{flex:none;font-size:12px;color:#28634f;font-weight:700;line-height:24px}
.model-panel .model-details-toggle,.model-panel .model-copy{width:auto;min-width:0;padding:8px 0;margin:4px 0 0;background:transparent;text-align:left;font-size:12px;line-height:1.4;color:#64766b}.model-details{border-top:1px solid #dce6dd;padding-top:8px}.model-id{font-size:12px;word-break:break-all;color:#68786d}.model-panel .model-copy{color:#28634f}.model-panel .model-more{box-sizing:border-box;width:100%;margin:8px 0;padding:12px;background:#e3eee6;color:#285c4c;font-size:14px;line-height:1.4}.model-empty{padding:36px 12px;color:#738077;font-size:14px;text-align:center}
.model-panel .model-close::after,.model-panel .step-back::after,.model-panel .provider-card::after,.model-panel .model-select::after,.model-panel .model-details-toggle::after,.model-panel .model-copy::after{border:0}
