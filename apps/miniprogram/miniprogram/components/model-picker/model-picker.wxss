.model-modal{position:fixed;inset:0;z-index:240;display:flex;align-items:flex-end;background:rgba(15,22,19,.58)}
.model-panel{width:100%;height:92vh;box-sizing:border-box;padding:24rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));border-radius:30rpx 30rpx 0 0;background:#f8f7f2}
.model-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx}.model-kicker{color:#17221e;font-size:31rpx;font-weight:850}.model-note{margin-top:6rpx;color:#76807b;font-size:19rpx;line-height:1.4}.model-close{display:flex;align-items:center;justify-content:center;flex:none;height:58rpx;margin:0;padding:0 20rpx;border-radius:999rpx;font-size:20rpx;line-height:1.2}
.model-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin-top:20rpx;padding:7rpx;border-radius:16rpx;background:#e7ebe5}.model-step{display:flex;align-items:center;justify-content:center;gap:6rpx;min-width:0;height:58rpx;border-radius:12rpx;color:#78807c;font-size:18rpx;font-weight:760}.model-step.active{background:#285c4c;color:#fff}.model-step.done{color:#285c4c}.model-step-index{display:flex;align-items:center;justify-content:center;width:28rpx;height:28rpx;border:1rpx solid currentColor;border-radius:50%;font-size:16rpx}
.model-scroll{height:calc(92vh - 190rpx);margin-top:14rpx}.step-title{margin:14rpx 0 12rpx;color:#27332f;font-size:24rpx;font-weight:820}.step-back{display:flex;align-items:center;justify-content:center;width:auto;height:52rpx;margin:6rpx 0 0;padding:0 16rpx;border-radius:999rpx;background:#e8eee9;color:#285c4c;font-size:19rpx;line-height:1.2}.step-context{margin-top:12rpx;color:#6f7773;font-size:19rpx}
.provider-list,.vendor-list,.model-list{padding-bottom:80rpx}.provider-card,.vendor-card{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;width:100%;min-height:92rpx;margin:0 0 12rpx;padding:16rpx 18rpx;border:1rpx solid #d9ddd7;border-radius:16rpx;background:#fff;text-align:left;line-height:1.3}.card-title{color:#1d2925;font-size:24rpx;font-weight:820}.card-note{margin-top:5rpx;color:#7a827e;font-size:18rpx}.card-count{color:#326453;font-size:18rpx}.provider-arrow,.vendor-arrow{margin-left:8rpx;font-size:28rpx}
.catalog-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8rpx;margin-top:14rpx;padding:6rpx;border-radius:14rpx;background:#e7ebe5}.catalog-tab{display:flex;align-items:center;justify-content:center;height:58rpx;margin:0;border-radius:11rpx;background:transparent;color:#6f7773;font-size:19rpx;line-height:1.2}.catalog-tab.active{background:#285c4c;color:#fff}
.model-search{box-sizing:border-box;width:100%;height:72rpx;margin-top:14rpx;padding:0 18rpx;border:1rpx solid #d5d8d2;border-radius:14rpx;background:#fff;font-size:22rpx}.model-count{margin:14rpx 0 10rpx;color:#67716c;font-size:19rpx}.model-row{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;width:100%;min-height:108rpx;margin:0 0 10rpx;padding:16rpx;border:1rpx solid #dde0da;border-radius:15rpx;background:#fff;text-align:left;line-height:1.3}.model-row.selected{border:2rpx solid #2f6555;background:#edf7f1}.model-main{min-width:0}.model-name{color:#1d2925;font-size:23rpx;font-weight:800;white-space:normal}.model-id{margin-top:5rpx;color:#7b817d;font-size:17rpx;word-break:break-all}.model-badges{display:flex;flex-wrap:wrap;gap:6rpx;margin-top:9rpx}.model-badge{padding:4rpx 7rpx;border-radius:7rpx;background:#f0e8ce;color:#735b20;font-size:15rpx}.model-check{flex:none;margin-left:12rpx;color:#2f6555;font-size:28rpx}.model-row.disabled{opacity:.62;background:#eceeea}.model-more,.incompatible-toggle{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;height:62rpx;margin:12rpx 0 0;border-radius:13rpx;background:#e5eee8;color:#285c4c;font-size:20rpx;line-height:1.2}.incompatible{margin-top:24rpx}.incompatible-toggle{background:#f3e9e2;color:#8d533b}.model-empty{padding:60rpx 0;text-align:center;color:#7b817d;font-size:21rpx}
