.model-modal { position:fixed; inset:0; z-index:220; display:flex; align-items:flex-end; background:rgba(15,22,19,.54); }
.model-panel { width:100%; height:88vh; box-sizing:border-box; padding:28rpx; border-radius:30rpx 30rpx 0 0; background:#f8f7f2; }
.model-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.model-kicker { color:#17221e; font-size:31rpx; font-weight:850; }.model-note{margin-top:5rpx;color:#76807b;font-size:21rpx}.model-close{margin:0;padding:0 20rpx;height:56rpx;line-height:56rpx;border-radius:999rpx;font-size:21rpx}
.model-search { height:76rpx; margin-top:20rpx; padding:0 22rpx; border:1rpx solid #d5d8d2; border-radius:16rpx; background:#fff; font-size:24rpx; }
.model-scroll { height:calc(88vh - 170rpx); margin-top:18rpx; }.channel{margin-bottom:28rpx}.channel-title{position:sticky;top:0;z-index:2;padding:14rpx 0;color:#245244;background:#f8f7f2;font-size:27rpx;font-weight:850}.vendor-title{margin:10rpx 0 8rpx;color:#827051;font-size:20rpx;font-weight:800;letter-spacing:1rpx}.model-row{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-bottom:8rpx;padding:17rpx;border:1rpx solid #dde0da;border-radius:14rpx;background:#fff}.model-row.selected{border-color:#2f6555;background:#edf7f1}.model-row.disabled{opacity:.58;background:#eee}.model-name{font-size:23rpx;font-weight:760}.model-id{margin-top:4rpx;color:#7b817d;font-size:18rpx;word-break:break-all}.model-state{flex:none;color:#3c705f;font-size:18rpx}.incompatible-title{margin:24rpx 0 10rpx;color:#9a5e42;font-size:20rpx;font-weight:800}.model-empty{padding:80rpx 0;text-align:center;color:#7b817d}
