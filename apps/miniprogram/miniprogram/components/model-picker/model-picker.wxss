.model-head-copy,.provider-copy,.model-main{flex:1;min-width:0}
.model-panel .model-close,.model-panel .step-back{width:auto;flex:none;margin:0;font-size:13px;background:transparent;color:#285c4c}
.model-modal{position:fixed;inset:0;z-index:240;display:flex;align-items:flex-end;background:rgba(15,22,19,.58)}
.model-panel{display:flex;flex-direction:column;box-sizing:border-box;width:100%;height:92%;padding:18px 16px calc(12px + env(safe-area-inset-bottom));border-radius:22px 22px 0 0;background:#f8f7f2}
.model-head{display:flex;align-items:flex-start;gap:12px;padding-bottom:12px}.model-kicker{font-size:18px;font-weight:750;color:#173b30}.model-note{margin-top:6px;font-size:12px;line-height:1.5;color:#68786e}
.model-panel .model-close{padding:0 8px;height:36px;line-height:36px;}
.model-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px}
.model-panel .step-back{padding:10px 0;line-height:1.4;}
.model-search{box-sizing:border-box;width:100%;height:42px;margin:8px 0;padding:0 12px;border:1px solid #d8ded8;border-radius:10px;background:white;font-size:14px}
.model-scroll{flex:1;min-height:0;height:0}.provider-list,.vendor-list,.model-list{padding:6px 0 22px}
.model-panel .provider-card{display:flex;align-items:center;justify-content:space-between;box-sizing:border-box;width:100%;min-width:0;margin:0 0 8px;padding:14px 12px;border:1px solid #d8e0d9;border-radius:12px;background:#fff;text-align:left;line-height:1.4}
.card-title{font-size:16px;font-weight:700;color:#253a30;word-break:break-word}.card-note{margin-top:5px;font-size:12px;color:#728077;line-height:1.5;word-break:break-word}.card-count{flex:none;margin-left:12px;font-size:12px;color:#326453}.model-panel .provider-card.current{border-color:#67917e;background:#eef6f0}
.model-count{margin:6px 0 12px;font-size:12px;color:#748076}.model-row{box-sizing:border-box;width:100%;margin-bottom:10px;padding:12px;border:1px solid #dce3dc;border-radius:12px;background:#fff}.model-row.selected{border-color:#418168;background:#edf7f1}.model-name{font-size:16px;font-weight:750;color:#213b2f;word-break:break-word}.model-panel .model-copy{width:auto;min-width:0;padding:8px 0;margin:4px 0 0;background:transparent;text-align:left;font-size:12px;line-height:1.4;color:#28634f}.model-details{border-top:1px solid #dce6dd;padding-top:8px}.model-id{font-size:12px;word-break:break-all;color:#68786d}.model-panel .model-more{box-sizing:border-box;width:100%;margin:8px 0;padding:12px;background:#e3eee6;color:#285c4c;font-size:14px;line-height:1.4}.model-empty{padding:36px 12px;color:#738077;font-size:14px;text-align:center}

.model-steps{display:flex;align-items:center;gap:4px;padding:4px 0}.model-panel .flow-step{flex:1;min-width:0;width:0;margin:0;padding:10px 2px;border-radius:7px;background:#e8ede7;color:#64766b;font-size:12px;line-height:1.5;font-weight:600;white-space:nowrap}.model-panel .flow-step.active{background:#315e50;color:#fff}.flow-arrow{flex:none;color:#8b998f;font-size:11px}.model-path{padding:10px 0 4px;font-size:12px;line-height:1.6;color:#4e6b5d;overflow-wrap:anywhere}.step-caption{font-size:12px;color:#758379}

.model-audit-specs { padding: 12rpx 20rpx; font-size: 24rpx; }
.model-audit-specs > view { display:flex; justify-content:space-between; gap:12rpx; padding:4rpx 0; }
.model-audit-specs text { overflow-wrap:anywhere; min-width:0; }

.model-row.is-paused { opacity: .55; }

.modality-icons{display:flex;justify-content:flex-end;gap:8px}
.modality-icon{position:relative;width:20px;height:20px;flex:0 0 20px;color:#213b2f}
.modality-glyph{width:100%;height:100%;background:currentColor;mask:var(--glyph) center/contain no-repeat;-webkit-mask:var(--glyph) center/contain no-repeat}
.modality-icon.is-unsupported,.modality-icon.is-unknown,.modality-icon.is-unlisted{color:#68786d}
.modality-icon.is-unknown,.modality-icon.is-unlisted{outline:1px dashed currentColor;outline-offset:-1px;border-radius:4px}
.modality-strike{position:absolute;top:9px;left:0;width:20px;height:2px;background:currentColor;transform:rotate(-45deg)}
.modality-question{position:absolute;bottom:0;right:0;width:10px;height:10px;border-radius:50%;background:#fff;color:#213b2f;font-size:10px;line-height:1;text-align:center;font-weight:700}
