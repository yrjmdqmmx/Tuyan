.library-panel{margin-top:20rpx;padding:20rpx;border:1rpx solid #d6ded7;border-radius:18rpx;background:#fff}.library-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12rpx}.library-title{font-size:26rpx;font-weight:830}.library-note{margin-top:5rpx;color:#77807b;font-size:19rpx;line-height:1.4}.library-refresh{flex:none;margin:0}.library-search{display:grid;grid-template-columns:minmax(0,1fr);gap:10rpx;margin-top:16rpx}.library-search-input{box-sizing:border-box;min-width:0;width:100%;height:66rpx;padding:0 14rpx;border:1rpx solid #d8dcd5;border-radius:12rpx;background:#fafbf8;font-size:20rpx}.library-search-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;min-width:0;width:100%;height:66rpx;margin:0;padding:0;border-radius:12rpx;background:#2c6151;color:#fff;font-size:20rpx;line-height:1.2;white-space:nowrap}.library-filters{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10rpx;margin-top:12rpx}.library-filter-value{height:62rpx;overflow:hidden;padding:0 13rpx;border:1rpx solid #d8dcd5;border-radius:11rpx;color:#59645f;font-size:19rpx;line-height:62rpx;text-overflow:ellipsis;white-space:nowrap}.library-loading,.library-error{padding:36rpx 0;text-align:center;color:#75807b;font-size:21rpx}.library-error{color:#a54836}.library-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12rpx;margin-top:16rpx}.library-card{min-width:0;overflow:hidden;border:1rpx solid #dce0da;border-radius:14rpx;background:#fafbf8}.library-card.selected{border:2rpx solid #2e6654;background:#eef6f0}.library-image-wrap{position:relative}.library-image{display:block;width:100%;height:190rpx;background:#e8ece7}.library-image.fallback{display:grid;place-items:center;color:#668074;font-size:20rpx}.library-task{position:absolute;left:9rpx;top:9rpx;padding:5rpx 8rpx;border-radius:7rpx;background:rgba(22,55,46,.86);color:#fff;font-size:14rpx;font-weight:800;letter-spacing:1rpx}.library-card-body{padding:13rpx}.library-card-title{height:60rpx;overflow:hidden;font-size:21rpx;font-weight:760;line-height:1.4}.library-card-meta{height:28rpx;margin-top:5rpx;overflow:hidden;color:#84908a;font-size:17rpx;white-space:nowrap}.library-select{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;height:54rpx;margin:12rpx 0 0;padding:0;border-radius:10rpx;background:#e7f1eb;color:#2e6654;font-size:19rpx;font-weight:750;line-height:1.2}.library-pagination{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:8rpx;margin-top:18rpx;color:#6f7974;font-size:17rpx}.library-page-state{text-align:center;line-height:1.35}.library-page-button{display:flex;align-items:center;justify-content:center;height:54rpx;margin:0;padding:0 12rpx;border-radius:10rpx;font-size:18rpx;line-height:1.2}.library-detail-mask{position:fixed;inset:0;z-index:250;display:flex;align-items:center;padding:30rpx;background:rgba(13,20,17,.65)}.library-detail{max-height:86vh;overflow:auto;padding:20rpx;border-radius:22rpx;background:#fff}.library-detail-image{width:100%;max-height:700rpx;border-radius:14rpx}.library-detail-title{margin-top:18rpx;font-size:27rpx;font-weight:830}.library-detail-summary{margin-top:10rpx;color:#65706a;font-size:21rpx;line-height:1.6}.library-detail-close{margin-top:20rpx;background:#2d6151;color:#fff}
