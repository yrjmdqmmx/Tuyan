.optimization-actions{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:12rpx}.optimization-actions button{margin:0;color:#24604e;background:#edf5f0;font-size:23rpx;line-height:2.3}.optimization-error{width:100%;color:#a43f31;font-size:24rpx;line-height:1.6;margin-top:12rpx;word-break:break-all}.optimization-mask{position:fixed;inset:0;z-index:2500;background:rgba(15,30,24,.42);display:flex;align-items:flex-end}.optimization-sheet{width:100%;box-sizing:border-box;background:#fafbf8;border-radius:32rpx 32rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));box-shadow:0 -10rpx 60rpx rgba(20,50,35,.14)}.optimization-head{display:flex;align-items:flex-start;gap:20rpx;justify-content:space-between;margin-bottom:20rpx}.optimization-head button{margin:0;flex-shrink:0}.optimization-title{font-size:30rpx;font-weight:600;color:#243f32}.optimization-note{font-size:23rpx;color:#718178;margin-top:8rpx}.optimization-scroll{max-height:60vh;height:680rpx}.optimization-label{font-size:23rpx;color:#687e70;margin:18rpx 0 10rpx}.optimization-text{display:block;font-size:27rpx;line-height:1.8;white-space:pre-wrap;word-break:break-word;background:#f0f2ed;padding:22rpx;border-radius:16rpx}.optimization-text.candidate{background:#eaf3ec}.optimization-footer{display:flex;gap:18rpx;padding-top:24rpx}.optimization-footer button{flex:1;font-size:27rpx}.optimization-footer .adopt{background:#2d674f;color:white}
