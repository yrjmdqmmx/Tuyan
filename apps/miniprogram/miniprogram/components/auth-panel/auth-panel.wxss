.auth-panel { width:calc(100% - 48rpx); max-width:680rpx; max-height:calc(100vh - 72rpx); box-sizing:border-box; overflow-y:auto; padding:34rpx 30rpx 28rpx; border:1rpx solid rgba(255,255,255,.72); border-radius:30rpx; background:linear-gradient(165deg,#fff 0%,#f7faf6 100%); box-shadow:0 30rpx 90rpx rgba(20,45,35,.24); }
.auth-head { display:flex; align-items:flex-start; justify-content:space-between; gap:24rpx; }
.auth-heading { min-width:0; flex:1; }
.auth-kicker { margin-bottom:8rpx; color:#39715c; font-size:20rpx; font-weight:800; letter-spacing:2rpx; }
.auth-head .section-title { font-size:38rpx; line-height:1.25; }
.auth-head .section-note { margin-top:10rpx; color:#68766f; font-size:23rpx; line-height:1.55; }
.auth-close { flex:none; min-width:104rpx; min-height:88rpx; margin:0; padding:0 18rpx; border:1rpx solid #d8e1dc; border-radius:44rpx; background:#fff; color:#53635b; font-size:21rpx; line-height:88rpx; }
.auth-form { margin-top:28rpx; }
.auth-form .field + .field { margin-top:20rpx; }
.field-label { display:flex; align-items:center; justify-content:space-between; margin-bottom:10rpx; color:#34473e; font-size:23rpx; font-weight:750; }
.field-optional,.field-hint { color:#8b9791; font-size:19rpx; font-weight:500; }
.auth-input { width:100%; height:88rpx; min-height:88rpx; box-sizing:border-box; padding:0 22rpx; border:1rpx solid #d3ddd7; border-radius:16rpx; background:#fff; font-size:25rpx; line-height:normal; }
.auth-submit,.auth-action { display:flex; align-items:center; justify-content:center; width:100%; min-height:88rpx; box-sizing:border-box; margin:28rpx 0 0; border-radius:18rpx; font-size:25rpx; font-weight:800; }
.auth-form .text-button { min-height:88rpx; margin:8rpx 0 0; font-size:22rpx; }
.auth-state-card { margin-top:28rpx; padding:30rpx 24rpx 24rpx; border:1rpx solid #cfe0d5; border-radius:22rpx; background:#eef6f0; text-align:center; }
.recovery-card { border-color:#d7e3d9; background:#f4f8f2; }
.auth-state-icon { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin:0 auto 18rpx; border-radius:50%; background:#d9ebdf; color:#306851; font-size:34rpx; font-weight:900; }
.auth-state-title { color:#315342; font-size:25rpx; font-weight:850; }
.auth-state-email { max-width:100%; margin-top:8rpx; overflow-wrap:anywhere; color:#1f4938; font-size:24rpx; font-weight:700; }
.auth-state-copy { margin-top:14rpx; color:#607068; font-size:21rpx; line-height:1.65; }
.auth-back { min-height:88rpx; margin:8rpx 0 0; }
.auth-message { box-sizing:border-box; margin-top:18rpx; padding:16rpx 18rpx; border-radius:14rpx; font-size:21rpx; line-height:1.5; overflow-wrap:anywhere; }
.success-message { border:1rpx solid #c8dece; background:#edf7ef; color:#326248; }
.auth-message.error-box { border:1rpx solid #e8cbc3; background:#fff3f0; color:#9b4032; }
.auth-privacy { margin-top:20rpx; color:#8a958f; font-size:18rpx; line-height:1.5; text-align:center; }
@media (max-width:360px) { .auth-panel { width:calc(100% - 28rpx); padding:28rpx 22rpx 22rpx; } .auth-head { gap:14rpx; } .auth-head .section-title { font-size:34rpx; } }
