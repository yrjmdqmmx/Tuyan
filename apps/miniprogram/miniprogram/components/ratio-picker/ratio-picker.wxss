.ratio-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.ratio-grid .ratio-choice{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;box-sizing:border-box;width:100%;min-width:0;min-height:68px;margin:0;padding:8px 2px;border:1px solid #dbe1dc;border-radius:9px;background:#fff;color:#53645d;line-height:1.1}.ratio-choice::after,.ratio-expand::after{border:0}.ratio-icon{height:32px;width:32px;display:flex;align-items:center;justify-content:center}.ratio-shape{box-sizing:border-box;border:1px solid #b7c4bc;background:#e7ede8;border-radius:1px}.ratio-shape.auto{border-style:dashed;background:transparent}.ratio-label{font-size:12px;font-weight:600;white-space:nowrap}.ratio-grid .selected{border-color:#315f51;background:#edf4ef;color:#244f43}.selected .ratio-shape{border-color:#315f51;background:#b6ccc1}.ratio-check{position:absolute;top:3px;right:5px;font-size:11px;color:#315f51}.ratio-control .ratio-expand{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;margin:4px 0 0;padding:0;min-height:44px;background:transparent;color:#315f51;font-size:12px;line-height:1.3}.ratio-empty{font-size:12px;color:#88623f;line-height:1.6}
