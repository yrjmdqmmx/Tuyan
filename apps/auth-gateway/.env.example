NODE_ENV=production
HOST=0.0.0.0
PORT=3005

# Public URL of this gateway. Do not include /paperbanana-api.
AUTH_BASE_URL=https://api.paperbanana.asia
FRONTEND_ORIGINS=https://www.paperbanana.asia,https://paperbanana.asia,https://servicewechat.com,https://developers.weixin.qq.com

# Better Auth secrets and its dedicated logical database.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
MONGODB_URI=mongodb://paperbanana_auth:password@mongodb:27017/paperbanana_auth?authSource=paperbanana_auth&replicaSet=rs0
MONGODB_DB=paperbanana_auth
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Preferred Hong Kong Node core. If both URLs exist, this always wins and the
# gateway never falls through to Laf at runtime.
PAPERBANANA_API_URL=http://paperbanana-api:3000/paperbanana-api

# Explicit emergency rollback only. Leave unset during normal Node operation.
# LAF_API_URL=https://legacy.example/paperbanana-api

PAPERBANANA_BACKEND_TIMEOUT_MS=15000
PAPERBANANA_GATEWAY_TOKEN=replace-with-shared-gateway-token

# Required signed anonymous-owner cookie key. PREVIOUS supports key rotation
# without changing existing guest owners; remove it after the 30-day TTL.
PAPERBANANA_GUEST_COOKIE_SECRET=replace-with-at-least-32-random-bytes
PAPERBANANA_GUEST_COOKIE_SECRET_PREVIOUS=

# Admin access is granted only by immutable Better Auth user IDs. Email and
# caller-provided tokens are never authorization inputs.
ADMIN_USER_IDS=replace-with-better-auth-user-id

# Server-only backend credential. In Laf rollback it is injected only after an
# ADMIN_USER_IDS session passes authorization; callers can never supply it.
ADMIN_TOKEN=replace-with-internal-admin-token

# Dynamic maintenance control: either set the env flag or create the marker.
PAPERBANANA_MAINTENANCE_MODE=false
PAPERBANANA_MAINTENANCE_FILE=/opt/paperbanana/control/maintenance
PAPERBANANA_MAINTENANCE_RETRY_AFTER_SECONDS=300

# Used only to validate legacy clients that submit a signed result URL for
# refineImage. The gateway converts valid URLs back to an owned object key.
PAPERBANANA_BUCKET=replace-with-private-hong-kong-bucket
OSS_PUBLIC_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com

# Emergency Laf rollback compatibility only; never enable in Node production.
PAPERBANANA_ALLOW_LEGACY_EXTERNAL_REFINE_URL=false
