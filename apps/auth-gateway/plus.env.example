# Copy selected values to a PRIVATE environment file; defaults remain OFF.
# Sandbox and live resources are isolated. Live is restricted to existing admins.
# Do not enable purchases/tasks until platform readiness and model validation pass.
PLUS_ENABLED=false
PLUS_ADMIN_ONLY=true
# Readiness review of the formal SKU/channel; not proof of a completed real transaction.
PLUS_LIVE_COMMERCE_READY=false
PLUS_PAYMENT_ENVIRONMENT=sandbox
PLUS_EXECUTION_MODE=disabled
PLUS_MODEL_EXECUTION_ENABLED=false
PLUS_BACKGROUND_RECONCILIATION_ENABLED=false
# Reviewed credential-free pricing/bounds JSON; template stays invalid until verified.
# Production image path: /app/apps/auth-gateway/billing/plus-<version>.json.
# Local test pricing belongs outside the repository and must never enable production.
PLUS_PRICING_FILE=
PLUS_BAILIAN_API_KEY=
# Separate Core process (not Gateway): PAPERBANANA_PLUS_PREPARED=false
# Separate Web build: VITE_PLUS_PREPARATION_UI=false
PLUS_NEW_PURCHASES_ENABLED=false
PLUS_NEW_TASKS_ENABLED=false
PLUS_WATCHA_APPLICATION_ID=
PLUS_WATCHA_SANDBOX_SKU_ID=
PLUS_WATCHA_SANDBOX_ENTITLEMENT_ID=
PLUS_WATCHA_SANDBOX_API_KEY=
PLUS_PAYMENT_RETURN_URL=http://127.0.0.1:5189/__plus_preview
# Existing AUTH_SECRET / database / allowed origins are configured separately.
# Agent management tokens are NOT runtime API keys and do not belong here.

# Live only: use PLUS_PAYMENT_ENVIRONMENT=live and an HTTPS return URL.
# CN return example: https://tuyansci.cn/?view=account&section=account
# A return URL only navigates; membership always requires the backend access check.
# COMMERCE_VERIFIED means channel/SKU readiness was checked; it is not a paid-order test result.
PLUS_WATCHA_LIVE_SKU_ID=
PLUS_WATCHA_LIVE_ENTITLEMENT_ID=
PLUS_WATCHA_LIVE_API_KEY=
