import {readFile,writeFile,mkdir} from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {readMaterialBytes} from '../../apps/paperbanana-api/src/material-files.js';
const out=new URL('./evidence/',import.meta.url);await mkdir(out,{recursive:true});const manifest:any[]=[];
for(const [filename,pages] of [['mixed-research.pdf',[1,2,3,4,5,6]],['research-slides.pptx',[1,2]]] as const){const bytes=await readFile(new URL('./fixtures/'+filename,import.meta.url));const sourceHash=createHash('sha256').update(bytes).digest('hex');for(const page of pages){const reading=await readMaterialBytes(bytes,filename,{op:'render',pages:[page]});const image=reading.images[0],png=`final-${filename}-page-${page}.png`;await writeFile(new URL(png,out),Buffer.from(image.base64,'base64'));await writeFile(new URL(png+'.json',out),JSON.stringify({...reading,images:reading.images.map(({base64,...meta}:any)=>meta)},null,2));manifest.push({filename,sourceHash,page,png,renderHash:image.sha256,status:reading.status,warnings:reading.warnings})}const native=await readMaterialBytes(bytes,filename,{op:'read',pages:filename.endsWith('pptx')?[1,2]:[1,3]});await writeFile(new URL(`final-${filename}-native.json`,out),JSON.stringify(native,null,2))}
await writeFile(new URL('final-render-manifest.json',out),JSON.stringify({fixture:'synthetic fixtures generated by make-fixtures.py; not real research conclusions',realModelCalls:false,manifest},null,2));console.log('Saved '+manifest.length+' actual whole-page renders with exact source hashes.');
