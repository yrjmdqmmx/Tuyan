  "analysisMethods": [
    {
      "id": "mantel",
      "label": "Mantel 距离矩阵检验",
      "typeId": "matrix_link_overlay",
      "required": [
        "对齐样本的距离矩阵",
        "距离度量",
        "置换策略、次数、系数与P值来源"
      ],
      "checks": [
        "连线统计量不同于相关格",
        "不能把空间或组内依赖忽略为独立样本"
      ],
      "support": {
        "input": "user_precomputed_results",
        "computation": "not_implemented",
        "validation": "input_contract_and_render_only"
      }
    },
    {
      "id": "pca",
      "label": "PCA 主成分分析",
      "typeId": "ordination",
      "required": [
        "变量矩阵或已计算得分",
        "中心化/标准化",
        "载荷和解释方差来源"
      ],
      "checks": [
        "解释率在0..1且总和不超过1",
        "欧氏方差语义，不用距离矩阵冒充原始变量"
      ],
      "support": {
