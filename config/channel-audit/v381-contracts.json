    "systemMode": "system",
    "schema": {
      "type": "object",
      "required": [
        "model",
        "messages"
      ],
      "properties": {
        "model": {
          "const": "LongCat-2.5-Preview"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": [
                            "type",
                            "text"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "type": {
                              "const": "text"
                            },
                            "text": {
                              "type": "string"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "type",
                            "image_url"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "type": {
                              "const": "image_url"
                            },
                            "image_url": {
                              "type": "object",
                              "required": [
                                "url"
                              ],
                              "additionalProperties": false,
                              "properties": {
                                "url": {
                                  "type": "string",
                                  "pattern": "^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2}$"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 131072
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stream": {
          "type": "boolean"
        },
        "thinking": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "enabled",
                "disabled"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "x-constraints": []
    },
    "providerMaxImagesTentative": true,
    "providerMaxImageBytes": 10000000,
